#include <stdio.h>

#define TAM 10


void ordenar(int v[], int tam) {
    int i, j, temp;

    for (i = 0; i < tam - 1; i++) {
        for (j = 0; j < tam - 1 - i; j++) {
            if (v[j] < v[j + 1]) {
                temp = v[j];
                v[j] = v[j + 1];
                v[j + 1] = temp;
            }
        }
    }
}


void sumaYPromedio(int v[], int tam, int *suma, float *promedio) {
    int i;
    *suma = 0;

    for (i = 0; i < tam; i++) {
        *suma += v[i];
    }

    *promedio = (float) *suma / tam;
}

int main() {
    int vector[TAM];
    int i, suma;
    float promedio;

    
    printf("=== Carga de datos del vector (%d valores) ===\n", TAM);
    for (i = 0; i < TAM; i++) {
        printf("Ingrese el valor para la posicion [%d]: ", i);
        scanf("%d", &vector[i]);
    }

    
    ordenar(vector, TAM);

    printf("\n=== Vector ordenado de mayor a menor ===\n");
    for (i = 0; i < TAM; i++) {
        printf("Posicion [%d]: %d\n", i, vector[i]);
    }

    
    sumaYPromedio(vector, TAM, &suma, &promedio);

    printf("\nLa suma de los valores es: %d\n", suma);
    printf("El promedio de los valores es: %.2f\n", promedio);

    return 0;
}
